[Unit]
Description=gwt dev server for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="@GWT_SERVE_RUN@" %i
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
SuccessExitStatus=0 143
# next dev and concurrently spawn children that otherwise survive a stop and keep
# holding the port. Reap the whole cgroup.
KillMode=control-group
Environment=HOME=%h
Environment="PATH=@GWT_PATH@"
Environment="XDG_CONFIG_HOME=@GWT_CONFIG_HOME@"
Environment="XDG_STATE_HOME=@GWT_STATE_HOME@"

[Install]
WantedBy=default.target
