#compdef gwt

local -a subcmds
subcmds=(
  'add:create worktree and cd into it'
  'go:cd into worktree (create if needed)'
  'rm:remove worktree'
  'checkout:checkout a branch here (-f force-removes the worktree holding it)'
  'reset:cd back to main repo root (-d also removes the worktree)'
  'list:list all worktrees'
  'sync:re-carry files from the main checkout into an existing worktree'
  'include:show what a worktree would inherit (changes nothing)'
  'init:wizard that writes the .gwtrc for this repo'
  'setup:re-run the setup hook in this worktree'
  'serve:point the single dev server at the current worktree'
  'prune:remove worktrees whose branch is merged or gone on origin'
)

if (( CURRENT == 2 )); then
  _describe 'command' subcmds
  return
fi

local -a wt_branches
local subcmd="${words[2]}"

case "$subcmd" in
  add)
    _arguments -s \
      '-b[start point branch]:start branch:__git_branch_names' \
      ':branch name:'
    ;;
  go)
    wt_branches=( ${(f)"$(
      git worktree list --porcelain 2>/dev/null \
        | awk '/^branch refs\/heads\//{print substr($0,19)}'
    )"} )
    _arguments -s \
      '-b[start point branch]:start branch:__git_branch_names' \
      '--no-setup[skip the setup hook]' \
      ":branch name:(${wt_branches[*]})"
    ;;
  checkout|co)
    _arguments -s \
      '(-f --force)'{-f,--force}'[remove any worktree holding the branch first]' \
      ':branch name:__git_branch_names'
    ;;
  reset)
    _arguments -s '(-d --delete)'{-d,--delete}'[also remove the worktree you are leaving]'
    ;;
  prune)
    _arguments -s \
      '--merged[select branches merged into the default branch or gone on origin]' \
      '(-n --dry-run)'{-n,--dry-run}'[preview without removing anything]' \
      '(-f --force)'{-f,--force}'[skip the confirmation prompt]'
    ;;
  serve)
    if (( CURRENT == 3 )); then
      _describe 'serve command' '(
        start:point the server at this worktree and restart it
        stop:stop the server
        restart:restart it where it already points
        status:which worktree owns it, and is the port live
        logs:journal for this repo, -f to follow
        open:open the server URL in a browser
      )'
    else
      _arguments -s '(-f --force)'{-f,--force}'[follow the log output]'
    fi
    ;;
  init)
    _arguments -s '(-f --force)'{-f,--force}'[overwrite an existing .gwtrc]'
    ;;
  setup)
    _arguments -s '(-f --force)'{-f,--force}'[ignore the step cache and run every step]'
    ;;
  sync)
    wt_branches=( ${(f)"$(
      git worktree list --porcelain 2>/dev/null \
        | awk '/^branch refs\/heads\//{print substr($0,19)}'
    )"} )
    _arguments -s \
      '(-n --dry-run)'{-n,--dry-run}'[show what would change without touching anything]' \
      '(-f --force)'{-f,--force}'[replace directories the worktree already has]' \
      '--all[sync every worktree in this repo]' \
      ":branch name:(${wt_branches[*]})"
    ;;
  rm)
    if (( CURRENT == 3 )); then
      wt_branches=( ${(f)"$(
        git worktree list --porcelain 2>/dev/null \
          | awk '/^branch refs\/heads\//{print substr($0,19)}'
      )"} )
      (( ${#wt_branches} )) && _describe 'worktree branch' wt_branches
    fi
    ;;
esac
